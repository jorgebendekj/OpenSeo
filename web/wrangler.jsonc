{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findable-landing",
  "compatibility_date": "2026-02-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "routes": [
    {
      "pattern": "findableweb.io",
      "custom_domain": true,
    },
    {
      "pattern": "www.findableweb.io",
      "custom_domain": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "BACKLINK_CHECK_KV",
      "id": "296112328ecf4de1922afa7dc7be3193",
    },
  ],
  "ratelimits": [
    {
      "name": "BACKLINK_CHECK_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "env": {
    // Bindings are not inherited by named envs; keep preview's copies in sync.
    // Shared KV id is deliberate: one global daily budget across both workers.
    "preview": {
      "name": "findable-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "kv_namespaces": [
        {
          "binding": "BACKLINK_CHECK_KV",
          "id": "296112328ecf4de1922afa7dc7be3193",
        },
      ],
      "ratelimits": [
        {
          "name": "BACKLINK_CHECK_RATE_LIMIT",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
    },
  },
}
